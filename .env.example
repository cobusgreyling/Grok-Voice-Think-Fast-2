# xAI API key from https://console.x.ai/
# Optional for Demo mode; required for live Connect / mic / tools
XAI_API_KEY=xai-...

# Pin the flagship 2.0 model (recommended for this demo)
XAI_VOICE_MODEL=grok-voice-think-fast-2.0

# Server bind (use 0.0.0.0 inside Docker — compose sets this)
HOST=127.0.0.1
PORT=7861

# Default voice: eve | ara | rex | sal | leo
XAI_VOICE=eve
